{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "camctl 第一版状态报告",
  "description": "第一版业务状态报告：计划和动作结果、产物、交付、逐项失败及动作结束后的设备执行情况。跨实体语义、历史和累计覆盖检查见 report-format.md。",
  "type": "object",
  "properties": {
    "report_id": {
      "$ref": "#/$defs/entity_id"
    },
    "from_wm": {
      "$ref": "#/$defs/uint"
    },
    "to_wm": {
      "$ref": "#/$defs/uint"
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "plan_file_diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "required": [
    "report_id",
    "from_wm",
    "to_wm"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$(?![\\s\\S])"
    },
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonnegative_number": {
      "type": "number",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])",
      "description": "首尾 Unicode 空白按输入契约另作语义校验，不依赖不同正则引擎对空白的不同解释。"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$(?![\\s\\S])",
      "description": "固定到秒的 UTC 时间字面量 YYYY-MM-DD HH:mm:ss；不接受小数秒，日期和时间的实际有效性另按语义校验。"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "action_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/camera_action_type"
        },
        {
          "enum": [
            "obtain_action_outputs",
            "delete_action_outputs",
            "cancel_task",
            "report_status",
            "motor_control"
          ]
        }
      ]
    },
    "action_status": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "expired",
        "canceled"
      ]
    },
    "plan_status": {
      "enum": [
        "pending",
        "running",
        "completed"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/text"
        },
        "stage": {
          "$ref": "#/$defs/text"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "stage",
        "details"
      ],
      "additionalProperties": false,
      "description": "错误码及阶段为生产者登记的标识；驱动可提供具体原因。未知码保留展示，不改变实体状态或合并规则。details 按对应错误契约解释。"
    },
    "repair": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_needed",
            "succeeded",
            "failed",
            "canceled"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "media_duration": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unknown"
              ]
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available"
              ]
            },
            "seconds": {
              "$ref": "#/$defs/nonnegative_number"
            }
          },
          "required": [
            "status",
            "seconds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "check_status": {
          "enum": [
            "not_performed",
            "running",
            "completed",
            "failed",
            "unconfirmed"
          ]
        },
        "duration": {
          "$ref": "#/$defs/media_duration"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "check_status",
        "duration"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "check_status": {
                "const": "not_performed"
              }
            },
            "required": [
              "check_status"
            ]
          },
          "then": {
            "properties": {
              "duration": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "issues"
                  ]
                },
                {
                  "required": [
                    "error"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "check_status": {
                "enum": [
                  "failed",
                  "unconfirmed"
                ]
              }
            },
            "required": [
              "check_status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "camera_result": {
      "type": "object",
      "properties": {
        "check": {
          "allOf": [
            {
              "$ref": "#/$defs/media"
            },
            {
              "properties": {
                "check_status": {
                  "enum": [
                    "completed",
                    "failed",
                    "unconfirmed"
                  ]
                }
              }
            }
          ]
        },
        "repair": {
          "$ref": "#/$defs/repair"
        },
        "discard_cleanup": {
          "$ref": "#/$defs/discard_cleanup"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "obtain_failure": {
      "type": "object",
      "properties": {
        "source_action_instance_id": {
          "$ref": "#/$defs/entity_id"
        },
        "output_id": {
          "$ref": "#/$defs/entity_id"
        },
        "delivery_id": {
          "$ref": "#/$defs/entity_id"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "source_action_instance_id",
        "error"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "delivery_id": [
          "output_id"
        ]
      }
    },
    "obtain_result": {
      "type": "object",
      "properties": {
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obtain_failure"
          }
        }
      },
      "required": [
        "failures"
      ],
      "additionalProperties": false
    },
    "delete_item": {
      "type": "object",
      "properties": {
        "output_id": {
          "$ref": "#/$defs/entity_id"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "canceled"
          ]
        },
        "outcome": {
          "enum": [
            "deleted",
            "already_cleaned",
            "absence_confirmed"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "output_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "outcome"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "succeeded"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "outcome"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "delete_result": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delete_item"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "withdrawal": {
      "type": "object",
      "properties": {
        "delivery_id": {
          "$ref": "#/$defs/entity_id"
        },
        "status": {
          "enum": [
            "pending",
            "withdrawn",
            "not_retractable",
            "failed"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "delivery_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "cancel_item": {
      "type": "object",
      "properties": {
        "action_instance_id": {
          "$ref": "#/$defs/entity_id"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "canceled"
          ]
        },
        "outcome": {
          "enum": [
            "canceled",
            "already_terminal"
          ]
        },
        "withdrawals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/withdrawal"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "cancellation_effect": {
          "enum": [
            "not_applied",
            "applied",
            "not_required"
          ]
        }
      },
      "required": [
        "action_instance_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "outcome"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "succeeded"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "outcome"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "canceled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "cancellation_effect"
            ]
          }
        }
      ]
    },
    "cancel_result": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cancel_item"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "report_result": {
      "type": "object",
      "properties": {
        "report_id": {
          "$ref": "#/$defs/entity_id"
        }
      },
      "required": [
        "report_id"
      ],
      "additionalProperties": false
    },
    "checksum": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "not_obtained"
              ]
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "status",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "pending",
            "running",
            "completed",
            "incomplete",
            "canceled"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "output_id": {
          "$ref": "#/$defs/entity_id"
        },
        "source_action_instance_id": {
          "$ref": "#/$defs/entity_id"
        },
        "kind": {
          "enum": [
            "original",
            "repaired",
            "preview"
          ]
        },
        "original_name": {
          "$ref": "#/$defs/text"
        },
        "media_type": {
          "$ref": "#/$defs/text"
        },
        "size": {
          "$ref": "#/$defs/uint"
        },
        "derived_from_output_id": {
          "$ref": "#/$defs/entity_id"
        },
        "availability": {
          "enum": [
            "available",
            "restricted",
            "cleaned",
            "missing",
            "unknown"
          ]
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "preview_of_output_id": {
          "$ref": "#/$defs/entity_id"
        }
      },
      "required": [
        "output_id",
        "source_action_instance_id",
        "kind",
        "availability",
        "cleanup",
        "checksum",
        "media"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repaired"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "derived_from_output_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "original"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "derived_from_output_id"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "enum": [
                  "missing",
                  "unknown"
                ]
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "cleaned"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "cleanup": {
                "properties": {
                  "status": {
                    "const": "completed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cleanup": {
                "properties": {
                  "status": {
                    "const": "completed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "cleanup"
            ]
          },
          "then": {
            "properties": {
              "availability": {
                "const": "cleaned"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "preview"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "preview_of_output_id"
            ],
            "not": {
              "required": [
                "derived_from_output_id"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "preview_of_output_id"
              ]
            }
          }
        }
      ]
    },
    "delivery": {
      "type": "object",
      "properties": {
        "delivery_id": {
          "$ref": "#/$defs/entity_id"
        },
        "output_id": {
          "$ref": "#/$defs/entity_id"
        },
        "source_action_instance_id": {
          "$ref": "#/$defs/entity_id"
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.[A-Za-z0-9]+$(?![\\s\\S])"
        },
        "display_name": {
          "$ref": "#/$defs/text"
        },
        "size": {
          "$ref": "#/$defs/uint"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "pending",
            "preparing",
            "prepared",
            "publishing",
            "published",
            "failed",
            "canceled",
            "withdrawn"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "delivery_id",
        "output_id",
        "source_action_instance_id",
        "file_name",
        "display_name",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "prepared",
                  "publishing",
                  "published",
                  "withdrawn"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "size",
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "action_instance_id": {
          "$ref": "#/$defs/entity_id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/action_type"
        },
        "device_id": true,
        "scheduled_at": true,
        "group": true,
        "policy": true,
        "input_params": true,
        "extra_input_fields": {
          "type": "object",
          "minProperties": 1
        },
        "effective_params": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "type"
          ]
        },
        "status": {
          "$ref": "#/$defs/action_status"
        },
        "expiration_reason": {
          "enum": [
            "window_missed",
            "window_exhausted"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "result": {
          "type": "object"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivery"
          }
        },
        "automation": {
          "$ref": "#/$defs/automation"
        },
        "device_execution": {
          "$ref": "#/$defs/device_execution"
        }
      },
      "required": [
        "action_instance_id",
        "name",
        "type",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "error"
                  ]
                },
                {
                  "required": [
                    "expiration_reason"
                  ]
                },
                {
                  "required": [
                    "result"
                  ]
                },
                {
                  "required": [
                    "outputs"
                  ]
                },
                {
                  "required": [
                    "deliveries"
                  ]
                },
                {
                  "required": [
                    "device_execution"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "error"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "stage": {
                    "const": "admission"
                  }
                },
                "required": [
                  "stage"
                ]
              }
            },
            "required": [
              "error"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        },
        {
          "if": {
            "$ref": "#/$defs/admission_failure"
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "effective_params"
                  ]
                },
                {
                  "required": [
                    "result"
                  ]
                },
                {
                  "required": [
                    "outputs"
                  ]
                },
                {
                  "required": [
                    "deliveries"
                  ]
                },
                {
                  "required": [
                    "device_execution"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "expired"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/camera_action_type"
                  },
                  {
                    "const": "motor_control"
                  }
                ]
              }
            },
            "required": [
              "expiration_reason"
            ]
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "status": {
                  "const": "expired"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "expiration_reason"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "$ref": "#/$defs/camera_action_type"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "effective_params"
                  ]
                },
                {
                  "required": [
                    "outputs"
                  ]
                },
                {
                  "required": [
                    "device_execution"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "const": "obtain_action_outputs"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "deliveries"
                  ]
                },
                {
                  "required": [
                    "automation"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "camera_record"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "properties": {
                  "status": {
                    "enum": [
                      "running",
                      "expired",
                      "canceled"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "outputs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "$ref": "#/$defs/admission_failure"
            }
          },
          "then": {
            "properties": {
              "device_id": {
                "$ref": "#/$defs/id"
              },
              "scheduled_at": {
                "$ref": "#/$defs/timestamp"
              },
              "group": {
                "$ref": "#/$defs/name"
              },
              "policy": {
                "type": "object"
              },
              "input_params": {
                "type": "object"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "extra_input_fields"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "not": {
                  "properties": {
                    "type": {
                      "$ref": "#/$defs/camera_action_type"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              },
              {
                "not": {
                  "$ref": "#/$defs/admission_failure"
                }
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "device_id"
                  ]
                }
              ]
            },
            "allOf": [
              {
                "if": {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "motor_control"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  }
                },
                "then": {
                  "properties": {
                    "policy": {
                      "maxProperties": 0
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "obtain_action_outputs"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "not": {
                  "$ref": "#/$defs/admission_failure"
                }
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "group"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "enum": [
                      "obtain_action_outputs",
                      "delete_action_outputs"
                    ]
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "not": {
                  "$ref": "#/$defs/admission_failure"
                }
              }
            ]
          },
          "then": {
            "required": [
              "scheduled_at",
              "input_params"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "cancel_task"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "not": {
                  "$ref": "#/$defs/admission_failure"
                }
              }
            ]
          },
          "then": {
            "required": [
              "input_params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "camera_record"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/camera_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "obtain_action_outputs"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/obtain_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "delete_action_outputs"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/delete_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cancel_task"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/cancel_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "report_status"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/report_result"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "$ref": "#/$defs/camera_action_type"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "not": {
                  "$ref": "#/$defs/admission_failure"
                }
              }
            ]
          },
          "then": {
            "required": [
              "device_id",
              "scheduled_at",
              "input_params",
              "effective_params",
              "policy"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "enum": [
                      "obtain_action_outputs",
                      "delete_action_outputs",
                      "cancel_task"
                    ]
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "properties": {
                  "status": {
                    "enum": [
                      "running",
                      "succeeded",
                      "failed"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              {
                "not": {
                  "$ref": "#/$defs/admission_failure"
                }
              }
            ]
          },
          "then": {
            "required": [
              "result"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "report_status"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "properties": {
                  "status": {
                    "const": "succeeded"
                  }
                },
                "required": [
                  "status"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "result"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "report_status"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "not": {
                  "properties": {
                    "status": {
                      "const": "succeeded"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "result"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "camera_take_photo",
                  "camera_timelapse"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "result"
                  ]
                }
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "running",
                        "expired"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "outputs": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "obtain_action_outputs"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "properties": {
                  "input_params": {
                    "type": "object",
                    "properties": {
                      "purpose": {
                        "const": "auto_preview"
                      }
                    },
                    "required": [
                      "purpose"
                    ]
                  }
                },
                "required": [
                  "input_params"
                ]
              },
              {
                "not": {
                  "$ref": "#/$defs/admission_failure"
                }
              }
            ]
          },
          "then": {
            "required": [
              "automation"
            ]
          }
        },
        {
          "if": {
            "required": [
              "device_execution"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "$ref": "#/$defs/camera_action_type"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "expired",
                  "canceled"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motor_control"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "effective_params"
                  ]
                },
                {
                  "required": [
                    "outputs"
                  ]
                },
                {
                  "required": [
                    "deliveries"
                  ]
                },
                {
                  "required": [
                    "device_execution"
                  ]
                },
                {
                  "required": [
                    "result"
                  ]
                }
              ]
            },
            "allOf": [
              {
                "if": {
                  "not": {
                    "$ref": "#/$defs/admission_failure"
                  }
                },
                "then": {
                  "required": [
                    "scheduled_at",
                    "input_params",
                    "policy"
                  ],
                  "properties": {
                    "input_params": {
                      "$ref": "host-notification.schema.json#/$defs/motor_params"
                    },
                    "policy": {
                      "$ref": "plan.schema.json#/$defs/time_window_policy"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan_instance_id": {
          "$ref": "#/$defs/entity_id"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "status": {
          "$ref": "#/$defs/plan_status"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "required": [
        "plan_instance_id",
        "request_id",
        "created_at",
        "name",
        "status"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "diagnostic_id": {
          "$ref": "#/$defs/entity_id"
        },
        "file_name": {
          "$ref": "#/$defs/text"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/error"
              },
              {
                "properties": {
                  "stage": {
                    "enum": [
                      "input_read",
                      "input_parse",
                      "admission",
                      "ack"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "diagnostic_id",
        "file_name",
        "errors"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "errors": {
                "contains": {
                  "properties": {
                    "stage": {
                      "enum": [
                        "input_read",
                        "input_parse"
                      ]
                    }
                  },
                  "required": [
                    "stage"
                  ]
                }
              }
            },
            "required": [
              "errors"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "request_id"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "camera_action_type": {
      "enum": [
        "camera_take_photo",
        "camera_record",
        "camera_timelapse"
      ]
    },
    "automation": {
      "type": "object",
      "properties": {
        "purpose": {
          "const": "auto_preview"
        },
        "source_action_instance_id": {
          "$ref": "#/$defs/entity_id"
        }
      },
      "required": [
        "purpose"
      ],
      "additionalProperties": false,
      "description": "自动预览的展示关系；来源可靠确认后提供 source_action_instance_id。"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])",
      "description": "数据库对象 ID 的规范十进制字符串，整数范围为 1～9223372036854775807；19 位值另按上界约束校验。",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 18
        },
        {
          "pattern": "^(?:[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])"
        }
      ]
    },
    "request_id": {
      "$ref": "#/$defs/entity_id",
      "description": "调用方提供的正整数请求身份，使用规范十进制字符串，范围 1～9223372036854775807；用于幂等关联，不是主机分配的计划 ID。"
    },
    "admission_failure": {
      "type": "object",
      "properties": {
        "status": {
          "const": "failed"
        },
        "error": {
          "type": "object",
          "properties": {
            "stage": {
              "const": "admission"
            }
          },
          "required": [
            "stage"
          ]
        }
      },
      "required": [
        "status",
        "error"
      ]
    },
    "device_execution": {
      "type": "object",
      "description": "动作结束后，设备仍在执行该动作要求的工作，或尚未确认执行结束。只表达冻结历史中的可靠事实。",
      "properties": {
        "status": {
          "enum": [
            "still_running",
            "end_unconfirmed"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "discard_cleanup": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_needed",
            "pending",
            "running",
            "completed",
            "failed",
            "unknown"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ],
      "description": "取消要求涉及的拍摄内容处理结果；状态与错误来自实际处理事实。"
    }
  }
}
