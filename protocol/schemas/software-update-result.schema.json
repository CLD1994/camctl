{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camctl.local/schemas/software-update-result.schema.json",
  "title": "camctl 软件维护结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "action",
    "outcome",
    "effect",
    "eligibility",
    "prior_recovery",
    "prior_evidence",
    "reason",
    "stage",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "action": {
      "enum": [
        "check",
        "recover",
        "apply",
        "finalize"
      ]
    },
    "outcome": {
      "enum": [
        "not_started",
        "unchanged",
        "recovered",
        "applied",
        "failed",
        "recovery_required",
        "unknown"
      ]
    },
    "eligibility": {
      "enum": [
        "allowed",
        "blocked",
        "unknown"
      ]
    },
    "prior_recovery": {
      "enum": [
        "none",
        "recovered",
        "unknown"
      ]
    },
    "prior_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "effect": {
      "enum": [
        "not_started",
        "unchanged",
        "committed",
        "rolled_back",
        "recovery_required",
        "unknown"
      ]
    }
  },
  "x-exit-status": {
    "success": 0,
    "failure": 1,
    "success_outcomes": [
      "unchanged",
      "recovered",
      "applied"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "not_started"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "not_started"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unchanged"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "unchanged"
          },
          "eligibility": {
            "enum": [
              "allowed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "recovered"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "enum": [
              "unchanged",
              "rolled_back"
            ]
          },
          "eligibility": {
            "enum": [
              "allowed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "applied"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "committed"
          },
          "eligibility": {
            "enum": [
              "allowed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "recovery_required"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "enum": [
              "not_started",
              "unchanged",
              "recovery_required",
              "unknown"
            ]
          },
          "eligibility": {
            "enum": [
              "blocked",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "unknown"
          },
          "eligibility": {
            "enum": [
              "unknown",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "enum": [
              "unchanged",
              "rolled_back",
              "unknown"
            ]
          },
          "eligibility": {
            "enum": [
              "allowed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "finalize"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "not_started",
              "unchanged",
              "failed",
              "unknown"
            ]
          },
          "prior_recovery": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": { "const": "finalize" },
          "outcome": { "const": "unchanged" }
        }
      },
      "then": {
        "properties": {
          "effect": { "const": "unchanged" },
          "eligibility": { "const": "allowed" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": { "const": "finalize" },
          "outcome": { "const": "failed" }
        }
      },
      "then": {
        "properties": {
          "effect": { "const": "unchanged" },
          "eligibility": { "const": "allowed" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "not_started",
              "unchanged",
              "recovery_required",
              "unknown"
            ]
          },
          "prior_recovery": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "recover"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "not_started",
              "unchanged",
              "recovered",
              "recovery_required",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "apply"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "not_started",
              "applied",
              "failed",
              "recovery_required",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "check"
          },
          "outcome": {
            "const": "not_started"
          }
        }
      },
      "then": {
        "properties": {
          "eligibility": {
            "enum": [
              "blocked",
              "unknown"
            ]
          }
        }
      }
    }
  ],
  "x-labels": {
    "effect": {
      "not_started": "本次请求未开始",
      "unchanged": "本次请求没有修改原部署",
      "committed": "新版本已可靠提交",
      "rolled_back": "原部署已核实恢复",
      "recovery_required": "仍有未完成恢复责任",
      "unknown": "本次请求效果未知"
    },
    "eligibility": {
      "allowed": "更新责任允许启动",
      "blocked": "更新责任阻止启动",
      "unknown": "启动资格未知"
    }
  }
}
