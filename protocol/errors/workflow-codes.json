  },
  "$defs": {
    "segment_error_header": {
      "type": "object",
      "properties": {
        "source_action_instance_id": {
          "$ref": "status-report.schema.json#/$defs/entity_id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "gap_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
        "description": "缺口记录或区间的数量，不是缺失文件总数。正式公开报告中，null 表示缺口分类尚未确认，此时 gaps 为 [] 且 first_gap 省略；它不表示已确认无缺口。默认视频范围由冻结的范围事实独立决定，不由 gap_count 推导。0 表示已确认无缺口，此时 gaps 为 [] 且 first_gap 省略。正整数必须与完整 gaps 长度相同。"
        },
        "default_scope": {
          "$ref": "status-report.schema.json#/$defs/default_video_scope",
          "description": "来源已冻结的默认视频原片范围，与动作执行结果和本次交付结果分别表达。正式公开报告必须完整提供 output_ids；nonempty 的正 member_count 对应完整列表，且是 retained_output_ids 的子集；empty 为 0/[]；unknown 为 null/[]。unknown 的空数组只表示未保存已选关系，不表示已确认空范围。具体成员及顺序由同一历史边界的来源范围保证，不能从文件名或产物 ID 重算。照片不属于视频范围。"
        },
        "retained_original_count": {
          "type": "integer",
          "minimum": 0,
          "description": "同一历史边界全部合格且已登记的 ORIGINAL 视频数量，不包括 PREVIEW 或修复成品，须与完整 retained_output_ids 对应。"
        },
        "first_gap": {
          "$ref": "workflow-codes.json#/$defs/segment_gap",
          "description": "缺口数量为正时提供，与公开 gaps 第一项的全部事实一致，包括实际邻接文件和可用的 output_id。数量为 0 或 null 时省略，不以 null 代替。"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "workflow-codes.json#/$defs/segment_gap"
          },
          "description": "正式公开报告必填，按原冻结集合顺序完整展开。gap_count=null 时 [] 仅表示没有已确认缺口关系，不表示已确认无缺口。邻接实际性、集合身份及全部成员的完整性由同一历史边界的报告生产者保证。"
        },
        "retained_output_ids": {
          "type": "array",
          "items": {
            "$ref": "status-report.schema.json#/$defs/entity_id"
          },
          "uniqueItems": true,
          "description": "正式公开报告必填，完整列出与 retained_original_count 对应的 ORIGINAL 视频身份；零份时为 []。数组身份引用不要求每份增量报告重复携带全部 output 实体。"
        }
      },
      "required": [
        "source_action_instance_id",
        "description",
        "gap_count",
        "default_scope",
        "retained_original_count"
      ],
      "additionalProperties": false,
      "description": "分段来源结果的有限错误头。内部持久化允许省略增长数组；正式公开报告必须从同一冻结历史边界完整展开 gaps、retained_output_ids 和 default_scope.output_ids，并逐项核对原集合及实际视频原片身份，不能只比较数量。retained_output_ids 与 default_scope.output_ids 均只列视频原片；分段错误引用普通录像 camera_record 或原生延时 camera_timelapse 的视频结果，不用于单张拍摄。"
    },
    "segment_key": {
      "type": "object",
      "properties": {
        "directory_number": {
          "type": "integer",
          "minimum": 1
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      },
      "required": [
        "directory_number",
        "index"
      ],
      "additionalProperties": false
    },
    "segment_neighbor": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "known",
            "absent",
            "unknown"
          ]
        },
        "file_identity": {
          "type": "string",
          "minLength": 1
        },
        "output_id": {
          "$ref": "status-report.schema.json#/$defs/entity_id"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": [
              "file_identity"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "file_identity"
                  ]
                },
                {
                  "required": [
                    "output_id"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "segment_gap": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "missing_position",
            "zero_byte_non_tail"
          ]
        },
        "start_key": {
          "$ref": "workflow-codes.json#/$defs/segment_key"
        },
        "end_key": {
          "$ref": "workflow-codes.json#/$defs/segment_key"
        },
        "left": {
          "$ref": "workflow-codes.json#/$defs/segment_neighbor"
        },
        "right": {
          "$ref": "workflow-codes.json#/$defs/segment_neighbor"
        },
        "empty_file_identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "start_key",
        "end_key",
        "left",
        "right"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "zero_byte_non_tail"
              }
            }
          },
          "then": {
            "required": [
              "empty_file_identity"
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_file_identity"
              ]
            }
          }
        }
      ]
    }
  }
}
