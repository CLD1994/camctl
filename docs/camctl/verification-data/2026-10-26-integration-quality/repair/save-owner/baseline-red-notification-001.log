            owner.saves.begin(BaselineChunkSave(intent.activity_id, 2, entries, 1000))
            response = BaselineChunkResult(intent.activity_id, 2, 12)
            expected_applications = [("chunks", 2), ("entries", 5), ("cursor", cursor)]
