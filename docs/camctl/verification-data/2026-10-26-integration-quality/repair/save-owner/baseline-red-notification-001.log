            owner.saves.begin(BaselineFixSave(intent.activity_id, 1, 3, 1000))
            response = BaselineRef(intent.activity_id, BaselineState.FIXED, 11, 11, 1, 3)
            expected_applications = [("completed", True), ("closed", True)]
