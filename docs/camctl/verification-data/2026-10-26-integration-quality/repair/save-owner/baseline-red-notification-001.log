        intent = _intent()
        cursor = DirectoryCursor(intent.binding, intent.directories, 0, "/data/A/b.mp4")
        owner = PendingBaseline(intent.activity_id, intent.binding, intent.directories,
            chunks=1, entries=3, next_cursor=cursor)
