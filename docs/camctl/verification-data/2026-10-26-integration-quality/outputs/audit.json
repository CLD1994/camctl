  "audit_basis": [
    {
      "path": "docs/architecture/file-copy.md",
      "section": "读取工作的发现与唤醒",
      "contract": "每种固定流程只保存一个继续位置，不累计历次页面；候选详情受批次限制。"
    },
    {
      "path": "docs/camctl/database/consistency-verification.md",
      "section": "验收 W-11",
      "contract": "真实分批发现、详情淘汰、后续批次继续。"
    },
    {
      "path": ".agents/rules/testing.md",
      "section": "控制集成测试成本",
      "contract": "测试侧优化保持声明规模、真实提交及可证伪的释放观察。"
    }
  ],
  "change": "每页删除page后，只有仍存活的候选弱引用才触发gc.collect，然后执行原来的全部释放断言。正常路径不做强制GC；不可达循环仍经GC验证，owner强引用仍拒绝。",
  "assertions_preserved": [
    {
      "assertion": "真实grant_file成功且copy_id非空",
      "preservation": "120个新增消费者全部真实建档；夹具另有2个，共122次grant_file，与基线相同。"
    },
    {
      "assertion": "总量与批次三分区",
      "preservation": "(12,1)、(120,1)、(120,3)完全保留；扫描数量14、122、122。"
    },
    {
      "assertion": "returned <= batch_size且owner.cursor_count <= 1",
      "preservation": "每页原断言不变。"
    },
    {
      "assertion": "逐页所有候选弱引用均为空",
      "preservation": "每页原all断言不变，仅把无条件GC改为仍存活时GC；附具体失败消息。"
    },
    {
      "assertion": "seen == total + 2",
      "preservation": "每轮原总数断言不变。"
    },
    {
      "assertion": "connection.query_plan非空且max(connection.returned)==batch_size",
      "preservation": "原查询计划与真实读取上限断言不变；输出仍观察到索引查找及临时排序。查询计划存在断言本身不证明恒定SQL工作量。"
    },
    {
      "assertion": "扫描前后iterdump相等",
      "preservation": "每轮原数据库不变断言不变。"
    },
    {
      "assertion": "扫描结束游标数",
      "preservation": "原输出字段cursor_count_after_scan保留，三轮均为0；未将原输出误记为新增断言。"
    }
  ],
