    @pytest.mark.parametrize("waiter_result", ["succeeded", "failed", "canceled"])
    async def test_last_bound_waiter_releases_new_source_input_in_original_run(
            tmp_path, monkeypatch, waiter_result):
        owned, capture, source_id, early, maintenance, context = await _published_world(
            tmp_path, (Decimal(60),))
        try:
            input_id, relative = owned.connection.execute(
                "SELECT id,relative_path FROM intermediate_files WHERE owner_action_id=?",
                (source_id,)).fetchone()
            # 原来源 H 在等待者仍运行时已消费，资格初筛不算实际清理。
            await maintenance.flow(context)
            await maintenance.settle()
            assert not maintenance.processed
            assert (tmp_path / "staging" / relative).exists()
            horizon = maintenance._discovery_after
            obtain = _obtain_runtime(owned, tmp_path, maintenance)
            if waiter_result == "canceled":
                for index, (waiter, _selection) in enumerate(early):
                    _cancel(owned, capture, waiter)
                    settled = obtain.outputs.settle_canceled_obtain(
                        SettleCanceledObtain(waiter, capture.wall_us(), ()),
                        new_operation_key(), owned)
                    assert settled.kind is DbOutcomeKind.COMPLETED, settled.error
                    assert settled.value.complete
                    if index == 0:
                        await maintenance.flow(context)
                        await maintenance.settle()
                        assert not maintenance.processed
                        assert (tmp_path / "staging" / relative).exists()
            else:
                if waiter_result == "failed":
                    from camctl.devices.read_session import ReadChunk
                    monkeypatch.setattr(
                        "camctl.host_files.io.LocalSourceReader.read_chunk",
                        lambda _reader, _limit: ReadChunk(data=None, error="local read refused"))
                for _ in range(4):
                    await advance_obtain(obtain)
            expected = {"succeeded": 3, "failed": 4, "canceled": 6}[waiter_result]
            assert [owned.connection.execute(
                "SELECT status FROM actions WHERE id=?", (identity,)).fetchone()[0]
                for identity, _selection in early] == [expected, expected]
            assert owned.connection.execute(
                "SELECT last_event_id FROM actions WHERE id=?", (early[-1][0],)
            ).fetchone()[0] > horizon
    
            # 后到请求仍在运行，不属于来源 H 的复用集合。
            late, _selection = _obtain(owned, capture, source_id, "default", 22)
>           await maintenance.flow(context)

